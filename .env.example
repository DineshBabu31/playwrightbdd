# BrowserStack credentials
BROWSERSTACK_USER=your_browserstack_username
BROWSERSTACK_ACCESS_KEY=your_browserstack_access_key

# Optional BrowserStack run metadata
BROWSERSTACK_OS=Windows
BROWSERSTACK_OS_VERSION=10
BROWSERSTACK_BUILD_NAME=playwrightbdd-build
BROWSERSTACK_PROJECT_NAME=playwrightbdd

# Local run settings
BROWSER=chromium
PARALLEL_THREAD=1
RETRIES=0
RECORD_VIDEO=false
TEST_TIMEOUT=1
